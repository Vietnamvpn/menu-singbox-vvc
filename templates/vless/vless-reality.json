{
  "type": "vless",
  "tag": "vless-reality-{{PORT}}",
  "listen": "::",
  "listen_port": "{{PORT}}",
  "users": [
    {
      "uuid": "{{UUID}}",
      "flow": "xtls-rprx-vision"
    }
  ],
  "tls": {
    "enabled": true,
    "server_name": "{{SNI}}",
    "reality": {
      "enabled": true,
      "handshake": {
        "server": "{{SNI}}",
        "server_port": 443
      },
      "private_key": "{{PRIVATE_KEY}}",
      "short_id": [
        "{{SHORT_ID}}"
      ]
    }
  }
}